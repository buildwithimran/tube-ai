# =====================================================================
# TubeAi API — example env. Copy to `.env` and fill in. NEVER commit .env.
# =====================================================================

# 1) Runtime
NODE_ENV=development
PORT=3035
# Comma-separated allowed origins (Angular dev server, etc.)
CORS_ORIGINS=http://localhost:4200

# 2) Database (MongoDB Atlas / local)
MONGODB_URI=mongodb://localhost:27017/TubeAi

# 3) Redis (cache + BullMQ queues) — required to run.
# Option A (local): host/port (+ password if your Redis has `requirepass`).
# Option B (cloud, e.g. Upstash): set REDIS_URL and leave host/port blank.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# 4) Auth & tokens (§47)
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# 5) Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6) AI provider — Google Gemini free tier ($0). Get a key at aistudio.google.com
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_DEFAULT=gemini-2.0-flash
AI_MODEL_STRUCTURED=gemini-2.0-flash
AI_MODEL_CHEAP=gemini-2.0-flash-lite
AI_MODEL_PREMIUM=gemini-2.5-pro

# 7) Free-plan limits (also seed the Free Plan; admin-editable after)
FREE_VIDEOS_PER_DAY=3
FREE_GENERATIONS_PER_DAY=15
FREE_MAX_VIDEO_SEC=1800

# 8) Email (SMTP for dev; use Resend/Brevo in prod)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 9) Storage (Cloudinary — avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
